# Copy to .env.local and fill in.
# Local values are printed by `npx supabase start` (or `npx supabase status`).
# Hosted values: Supabase dashboard -> Project Settings -> API Keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Used by `npm run cms:create-admin`; never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Address of the public site on the school server. Set it on Vercel (CMS links
# point there and signed-out visitors of public pages are sent there). Leave it
# unset locally so `npm run dev` serves the public pages too.
# NEXT_PUBLIC_SITE_URL=https://cict.wvsu.edu.ph
